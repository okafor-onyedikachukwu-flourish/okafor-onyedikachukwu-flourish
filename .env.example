# Your public site address: used for the canonical URL, sitemap, robots.txt
# and social share cards. Change it if you use a custom domain.
SITE_URL=https://okafor-onyedikachukwu-flourish.vercel.app

# Optional. Free key from Google AI Studio (aistudio.google.com).
# Without a key, the built-in offline engine answers questions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Questions allowed per visitor per minute (protects your API key).
CHAT_RATE_LIMIT=12

# Search engine verification codes (only the content="..." value).
# Google Search Console > HTML tag method:
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (also powers DuckDuckGo and Yahoo results):
BING_SITE_VERIFICATION=
# Yandex Webmaster (optional):
YANDEX_SITE_VERIFICATION=

# Optional X (Twitter) handle for link cards, e.g. flourish_dev
X_HANDLE=

# Local API port (Vite proxies /api here in development).
PORT=8787
